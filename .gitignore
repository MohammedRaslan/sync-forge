*.state.json

# Claude Code
.claude/

# Test scratch space (integration test for exported scripts)
engine/.script-test/

# Logs, coverage, OS and editor files
*.log
npm-debug.log*
coverage/
.DS_Store
Thumbs.db
.idea/
