# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo

# Environment files hold secrets; only the example is shared
.env
.env.*
!.env.example

# The workspace holds machine-local state. Commit workspace/jobs/ if you want to share job specs.
workspace/

