{
  "name": "sync-forge-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Syncforge engine: connectors, job runner and HTTP API",
  "license": "MIT",
  "exports": {
    "./standalone": {
      "types": "./dist/standalone.d.ts",
      "default": "./dist/standalone.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "standalone": [
        "dist/standalone.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.1",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "mongodb": "^6.21.0",
    "mysql2": "3.24.4",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "testcontainers": "^10.28.0",
    "typescript": "~5.6",
    "vitest": "^2.1.9"
  }
}
